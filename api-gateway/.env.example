# api-gateway Environment Configuration
APP_NAME=api-gateway
GATEWAY_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Eureka Server
EUREKA_SERVER=http://localhost:8761/eureka/

# JWT Authentication
JWT_SECRET=your_jwt_secret_at_least_32_chars

# Cross-Origin Allowed Origins (Comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# Internal Gateway Verification
INTERNAL_GATEWAY_SECRET=your_internal_gateway_secret

PRODUCTION_SERVICE_URL=https://your-production-service-url.example.com