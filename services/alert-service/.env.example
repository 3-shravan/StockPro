# ============================================================
#  alert-service — Environment Variables Template
# ============================================================

APP_NAME=alert-service
SERVER_PORT=8087
SPRING_PROFILES_ACTIVE=dev

JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRATION=86400000

LOCAL_DB_URL=jdbc:mysql://localhost:3306/stockpro_alert?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=password
LOCAL_JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

DB_URL=jdbc:mysql://alert-db:3306/stockpro_alert?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_prod_mysql_username
DB_PASSWORD=your_prod_mysql_password
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

ALERT_DEFAULT_EMAIL_TO=alerts@stockpro.local
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_user
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=noreply@stockpro.local
