# ============================================================
#  warehouse-service — Environment Variables (Template)
# ============================================================

APP_NAME=warehouse-service
SERVER_PORT=8083
SPRING_PROFILES_ACTIVE=dev

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=86400000

# Development (Local)
LOCAL_DB_URL=jdbc:mysql://localhost:3306/stockpro_warehouse?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=your_password

# Production
DB_URL=jdbc:mysql://production-db-host:3306/stockpro_warehouse?useSSL=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_password
