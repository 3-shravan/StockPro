# Generated .env for auth-service
APP_NAME=auth-service
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# Eureka Configuration
EUREKA_SERVER=http://localhost:8761/eureka/

# 💻 Development Database Configuration (Local MySQL)
LOCAL_DB_URL=jdbc:mysql://localhost:3306/stockpro_auth?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=your_local_db_password

# ☁️ Production Database Configuration (Aiven Cloud MySQL)
DB_URL=jdbc:mysql://production-db-host:3306/stockpro_auth?useSSL=true&requireSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true
DB_USERNAME=your_prod_db_username
DB_PASSWORD=your_prod_db_password

# JPA / Logging
LOCAL_JPA_SHOW_SQL=false
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# JWT Authentication
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRATION=86400000

# CORS / Security
CORS_ALLOWED_ORIGINS=http://localhost:3000
INTERNAL_GATEWAY_SECRET=your_internal_gateway_secret

PRODUCTION_SERVICE_URL=https://your-production-service-url.example.com
