# ============================================================
#  auth-service — Environment Variables Template
#  Copy this file to .env and fill in your local values.
#  .env.example IS committed; .env is NOT.
# ============================================================

# --- Common Application Settings ---
APP_NAME=auth-service
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# --- JWT Configuration ---
# Must be >= 32 characters for HMAC-SHA256
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
# Token expiry in milliseconds  (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# ============================================================
#  Development Profile Variables (Prefix: LOCAL_)
# ============================================================
LOCAL_DB_URL=jdbc:mysql://localhost:3306/stockpro_auth?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
LOCAL_DB_USERNAME=your_local_mysql_username
LOCAL_DB_PASSWORD=your_local_mysql_password

LOCAL_JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# --- CORS (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================
#  Production Profile Variables
# ============================================================
DB_URL=jdbc:mysql://production-db-host:3306/stockpro_auth?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_prod_mysql_username
DB_PASSWORD=your_prod_mysql_password

JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true
