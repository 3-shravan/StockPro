# ============================================================
#  movement-service — Environment Variables Template
#  Copy this file to .env and fill in your local values.
# ============================================================

# --- Common Application Settings ---
APP_NAME=movement-service
SERVER_PORT=8086
SPRING_PROFILES_ACTIVE=dev

# --- JWT Configuration ---
# Must match auth-service secret for validation
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRATION=86400000

# ============================================================
#  Development Profile Variables (Prefix: LOCAL_)
# ============================================================
LOCAL_DB_URL=jdbc:mysql://localhost:3306/stockpro_movement?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=password

LOCAL_JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# ============================================================
#  Production Profile Variables
# ============================================================
DB_URL=jdbc:mysql://movement-db:3306/stockpro_movement?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_prod_mysql_username
DB_PASSWORD=your_prod_mysql_password

JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true
