# Generated .env for supplier-service
APP_NAME=supplier-service
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8085

# Eureka Configuration
EUREKA_SERVER=http://localhost:8761/eureka/

# 💻 Development Database Configuration (Local MySQL)
LOCAL_DB_URL=jdbc:mysql://localhost:3306/stockpro_supplier?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=your_local_db_password

# ☁️ Production Database Configuration (Aiven Cloud MySQL)
DB_URL=jdbc:mysql://production-db-host:3306/stockpro_supplier?useSSL=true&requireSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true
DB_USERNAME=your_prod_db_username
DB_PASSWORD=your_prod_db_password

# JPA / Logging
LOCAL_JPA_SHOW_SQL=true
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# Security
INTERNAL_GATEWAY_SECRET=your_internal_gateway_secret
